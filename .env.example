# Copy to .env.local for local testing with `vercel dev`. In production, set these in Vercel > Project > Settings > Environment Variables.

# Square (developer.squareup.com > your app > Credentials / Locations)
SQUARE_ENV=sandbox
SQUARE_APP_ID=sandbox-sq0idb-xxxxxxxxxxxxxxxx
SQUARE_ACCESS_TOKEN=EAAAxxxxxxxxxxxxxxxxxxxxxxxx
SQUARE_LOCATION_ID=Lxxxxxxxxxxxxx
# Optional: Square customer groups to file sign-ups into (Square Dashboard > Customers > Groups)
SQUARE_WAITLIST_GROUP_ID=
SQUARE_CART_GROUP_ID=

# Email to the shop for sign-ups and coffee cart requests (resend.com, free tier)
RESEND_API_KEY=re_xxxxxxxxxxxx
NOTIFY_EMAIL=hello@yourshop.ca
# Once your domain is verified in Resend, e.g. "Studio Seven <website@studioseven.ca>"
FROM_EMAIL=

# Set to false to pause online ordering (e.g. before opening day or on a busy morning)
ORDERS_OPEN=true
